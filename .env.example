# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored.

# Used in Chapter 5 (decoders) and Chapter 6 (RAG with OpenAI generation)
OPENAI_API_KEY=sk-...

# Used in Chapter 6 — OpenRouter is a unified gateway to many LLMs
# Get a key at https://openrouter.ai
OPEN_ROUTER_API_KEY=sk-or-...

# Used in Chapter 6b — Kaggle credentials for downloading the research-papers dataset
# https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
